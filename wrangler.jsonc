// Réglages pour Cloudflare Workers Builds (ignorés par Cloudflare Pages)
{
  "name": "saare-telecom",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Garde les variables réglées dans le tableau de bord Cloudflare à chaque publication
  "keep_vars": true,
  // Base des statistiques (visites, vues, clics Commander). Sans identifiant ici :
  // Cloudflare crée la base « bimak-stats » toute seule à la première publication.
  "d1_databases": [{ "binding": "STATS", "database_name": "bimak-stats" }],
  "observability": { "enabled": true }
}
